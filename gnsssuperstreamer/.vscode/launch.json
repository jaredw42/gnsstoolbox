{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug gnsssuperstreamer",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/gnsssuperstreamer",
            "args": ["192.168.0.151", "8100", "192.168.0.117", "55556"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build",
            "miDebuggerPath": "/usr/bin/gdb",
            "logging": {
                "engineLogging": true
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "miDebuggerArgs": "",
            "stopAtEntry": false,
            "targetArchitecture": "x86_64",
            "externalConsole": false,
            "internalConsoleOptions": "openOnSessionStart",
            "showDisplayString": true
        }
    ]
}